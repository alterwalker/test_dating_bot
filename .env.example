# Telegram
BOT_TOKEN=
API_BASE_URL=http://localhost:8080/v1

# API & Worker
DATABASE_URL=postgres://dating:dating@localhost:5432/dating_bot?sslmode=disable
HTTP_ADDR=:8080
WORKER_HTTP_ADDR=:8081
WORKER_POLL_INTERVAL=2s

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval: ann (pgvector HNSW) | brute (in-memory, for tests)
RETRIEVAL_MODE=ann
RETRIEVAL_TOP_K=50

# Fallback без API (default) | mock LLM + mock embedder + template explainer
AI_MOCK=true

# Logging
LOG_LEVEL=info
