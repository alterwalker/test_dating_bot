# === Production / Ubuntu server (cp .env.prod.example .env) ===
# Полный стек в Docker: postgres + api + worker + bot
# Системный Postgres на :5432 не используется.

# Telegram
BOT_TOKEN=

# Bot → api внутри docker network
API_BASE_URL=http://api:8080/v1

# Postgres — сервис postgres в compose (внутренний порт всегда 5432)
POSTGRES_USER=dating
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dating_bot
POSTGRES_PORT=5433

DATABASE_URL=postgres://dating:CHANGE_ME_STRONG_PASSWORD@postgres:5432/dating_bot?sslmode=disable

# API снаружи (Ubuntu host). Внутри контейнера — :8080
HTTP_PORT=18080
HTTP_ADDR=:8080
WORKER_HTTP_ADDR=:8081
WORKER_POLL_INTERVAL=2s

# OpenAI
AI_MOCK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

RETRIEVAL_MODE=ann
RETRIEVAL_TOP_K=50

DEMO_MODE=true
DEMO_FICTIONAL_PREFIX=вымышленный_
DEMO_SEED_FILE=/seed/fictional_profiles.json

LOG_LEVEL=info
